theorem RegSub.theoremA_l2 :
  Exists
    (fun (X :
        Set
          (Subtype
            (fun (x : PreLp (fun (x._@.RegSub.Hilbert.171547502._hygCtx._hyg.10 : Nat) => Real)) =>
            Membership.mem (lp (fun (x._@.RegSub.Hilbert.171547502._hygCtx._hyg.10 : Nat) => Real) (OfNat.ofNat 2))
              x))) =>
    And (IsCompact X)
      (And (IsConnected X)
        (And (Set.Nontrivial X)
          (And (Nonempty (Homeomorph (Set.Elem (RegSub.regularSubcontinua (Set.Elem X))) (Nat → Nat)))
            (Nonempty
              (Homeomorph (Set.Elem (RegSub.regularSubcontinua (Set.Elem X)))
                (Subtype (fun (x : Real) => Irrational x)))))))) :=
  _

axiom propext {a b : Prop} : Iff a b → Eq a b

axiom Quot.sound.{u} {α : Sort u} {r : α → α → Prop} {a b : α} : r a b → Eq (Quot.mk r a) (Quot.mk r b)

axiom Classical.choice.{u} {α : Sort u} : Nonempty α → α

